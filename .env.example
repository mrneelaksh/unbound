# UNBOUND Production & Local Environment Variables Template
# Copy to .env.local for local overrides. DO NOT commit actual secrets.

# Supabase Public Browser Configuration (Safe for client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Server-Side Secret Key (Never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Application Session Secret (Random 32+ character hex string for signed HMAC cookies)
AUTH_SECRET=your-random-32-char-session-secret

# AI Coach API Key (Server-side only)
OPENAI_API_KEY=your-ai-api-key

# Payment Gateway Configuration (Server-side only)
PAYMENT_SECRET=your-payment-secret
PAYMENT_WEBHOOK_SECRET=your-payment-webhook-secret

# Base Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
